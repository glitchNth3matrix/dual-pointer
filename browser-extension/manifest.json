{
  "manifest_version": 3,
  "name": "YouTube Hover Lock",
  "version": "1.3.0",
  "description": "Keeps YouTube inline thumbnail video previews playing even when moving your mouse away, switching monitors, or clicking elsewhere.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Hover Lock Settings",
    "default_icon": {
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
